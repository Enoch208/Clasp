{
  "name": "clasp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "build:web": "pnpm --filter @clasp/web build",
    "verify": "pnpm typecheck && pnpm test && pnpm build:web"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
